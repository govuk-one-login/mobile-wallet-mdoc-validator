{
  "name": "@govuk/mobile-wallet-mdoc-validator",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}

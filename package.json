{
  "name": "@govuk-one-login/mobile-wallet-mdoc-validator",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/mobile-wallet-mdoc-validator.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "publish-v0-to-npm": "./publish-v0-to-npm.sh"
  },
  "dependencies": {
    "cbor2": "2.4.0",
    "jose": "^6.2.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
